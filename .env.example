# Copy this file to .env.local and add the credentials from Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Required in production. Keep each value private and stable.
SESSION_SECRET=
MEMBER_DATA_ENCRYPTION_KEY=

# Comma-separated HTTPS domains you are authorized to import products from.
PRODUCT_IMPORT_ALLOWED_HOSTS=
